        {% for cert in certifications %}
        <div class="cert-minimal">
            <span class="name">{{ cert.name }}</span>
            <span class="org">• {{ cert.issuing_organization }}</span>
            <span style="font-size: 13px; color: #999;">({{ cert.date_issued.strftime('%b %Y') }})</span>
        </div>
        {% endfor %}
    </div>
    
    <div class="section">
        <div class="section-title">Impact</div>
        <div class="impact-grid">
            <div class="impact-item">
                <div class="value">{{ sustainability_impact.get('co2_reduced', 0)|int }}</div>
                <div class="label">CO₂ Reduced (kg)</div>
            </div>
            <div class="impact-item">
                <div class="value">{{ sustainability_impact.get('energy_saved', 0)|int }}</div>
                <div class="label">Energy Saved (kWh)</div>
            </div>
            <div class="impact-item">
                <div class="value">{{ sustainability_impact.get('waste_diverted', 0)|int }}</div>
                <div class="label">Waste Diverted (kg)</div>
            </div>
            <div class="impact-item">
                <div class="value">{{ sustainability_impact.get('water_saved', 0)|int }}</div>
                <div class="label">Water Saved (L)</div>
            </div>
        </div>
        <div style="text-align: center; margin-top: 10px; font-size: 14px; color: #666;">
            {{ challenges_completed }} Challenges Completed • {{ badges|length }} Badges Earned
        </div>
    </div>
    
    <div class="section">
        <div class="section-title">Badges</div>
        <div>
            {% for badge in badges %}
            <span class="badge-minimal">{{ badge }}</span>
            {% endfor %}
        </div>
    </div>
    
    <div class="section">
        <div class="section-title">Achievements</div>
        {% for achievement in achievements %}
        <div class="achievement-item">{{ achievement }}</div>
        {% endfor %}
    </div>
</body>
</html>
"""
    
