        self.templates = self._initialize_templates()
        self.skill_level_map = {
            'NOVICE': 'Fundamental understanding',
            'BEGINNER': 'Basic practical skills',
            'INTERMEDIATE': 'Independent practitioner',
            'ADVANCED': 'Advanced expertise',
            'EXPERT': 'Subject matter expert',
            'MASTER': 'Industry leader'
        }
        self.skill_category_weights = {
            'energy_management': 0.85,
            'waste_reduction': 0.80,
            'water_conservation': 0.80,
            'sustainable_transport': 0.75,
            'sustainable_food': 0.75,
            'green_building': 0.90,
            'carbon_literacy': 0.95,
            'circular_economy': 0.85,
            'renewable_energy': 0.90,
            'sustainable_finance': 0.80,
            'eco_innovation': 0.85,
            'community_engagement': 0.70
        }
        
    def _initialize_templates(self) -> Dict:
        """Initialize CV templates"""
        return {
            'professional': self._get_professional_template(),
            'modern': self._get_modern_template(),
            'minimal': self._get_minimal_template(),
            'creative': self._get_creative_template(),
            'executive': self._get_executive_template(),
            'academic': self._get_academic_template(),
            'sustainability': self._get_sustainability_template(),
            'digital': self._get_digital_template()
        }
    
